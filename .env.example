# Copy to .env and fill in. Never commit .env.

# Required: Google AI Studio key used by MetaAgent itself. Generated agents never receive it.
GOOGLE_API_KEY=

# Optional overrides (defaults shown)
# METAAGENT_DEFAULT_MODEL=gemini-2.5-flash
# METAAGENT_AVAILABLE_MODELS=gemini-2.5-flash,gemini-2.5-pro
# METAAGENT_EMBEDDING_MODEL=gemini-embedding-001
# METAAGENT_AGENT_MODEL=gemini-2.5-flash
# METAAGENT_LLM_TIMEOUT_S=60
# METAAGENT_LLM_MAX_RETRIES=2
# METAAGENT_MAX_GENERATION_ATTEMPTS=2
# METAAGENT_TEST_RUN_TIMEOUT_S=60
# METAAGENT_LIVE_RUN_TIMEOUT_S=120
# METAAGENT_MAX_LLM_CALLS_PER_RUN=5
# METAAGENT_MAX_REQUEST_CHARS=2000
# METAAGENT_MAX_UPLOAD_MB=20
# METAAGENT_RAG_TOP_K=3
# METAAGENT_DATA_DIR=./data
