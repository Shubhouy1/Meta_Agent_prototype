# Copy to .env and fill in. Never commit .env.

# Required: Google AI Studio key used by MetaAgent itself. Generated agents never receive it.
GOOGLE_API_KEY=

# Optional overrides (defaults shown)
# METAAGENT_DEFAULT_MODEL=gemini-2.5-flash
# METAAGENT_AVAILABLE_MODELS=gemini-2.5-flash,gemini-2.5-pro
# METAAGENT_EMBEDDING_MODEL=gemini-embedding-001
# METAAGENT_AGENT_MODEL=gemini-2.5-flash
# METAAGENT_LLM_TIMEOUT_S=60
# METAAGENT_LLM_MAX_RETRIES=2
# METAAGENT_MAX_GENERATION_ATTEMPTS=2
# METAAGENT_TEST_RUN_TIMEOUT_S=60
# METAAGENT_LIVE_RUN_TIMEOUT_S=120
# METAAGENT_MAX_LLM_CALLS_PER_RUN=5
# METAAGENT_MAX_REQUEST_CHARS=2000
# METAAGENT_MAX_UPLOAD_MB=20
# METAAGENT_RAG_TOP_K=3
# METAAGENT_DATA_DIR=./data

# ── HTTP API (backend/) ──
# API keys: "name:role:key" entries separated by ";". Roles: viewer (read only) or builder
# (create builds, invoke deployments, manage/query documents). Keys must be >= 24 characters.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# With no valid keys every protected endpoint returns 401.
METAAGENT_API_KEYS=
# METAAGENT_CORS_ORIGINS=http://localhost:3000
# METAAGENT_DATABASE_URL=sqlite:///./data/metaagent.db   (default: <data dir>/metaagent.db)
# METAAGENT_DB_AUTO_MIGRATE=true
# METAAGENT_DOCS_ENABLED=true
# METAAGENT_MAX_CONCURRENT_BUILDS=2
# METAAGENT_MAX_QUEUED_BUILDS=10
# METAAGENT_BUILDS_PER_HOUR=20
# METAAGENT_INVOCATIONS_PER_MINUTE=10
# METAAGENT_MAX_CONCURRENT_INVOCATIONS=2
# METAAGENT_RAG_QUERIES_PER_MINUTE=20
# METAAGENT_RAG_UPLOADS_PER_HOUR=30
# METAAGENT_MAX_BODY_BYTES=1048576
# METAAGENT_SSE_HEARTBEAT_S=15
